//@version=6
strategy("Bhavishya Strategy V2 - Multi-Timeframe Trend & VWAP Volume Engine", 
         shorttitle="BHAVISHYA V2 [Trend+VWAP]", 
         overlay=true, 
         initial_capital=500, 
         default_qty_type=strategy.cash, 
         default_qty_value=500, 
         commission_type=strategy.commission.percent, 
         commission_value=0.03, 
         slippage=1, 
         precision=2)

// ==============================================================================
// 1. INPUTS
// ==============================================================================
grp_ut   = "1. UT Bot Engine"
a_mult   = input.float(2.0, "Key Value Sensitivity", minval=0.5, step=0.1, group=grp_ut)
c_per    = input.int(7, "ATR Period (Smoothed)", minval=1, group=grp_ut)

grp_vol  = "2. Volume & VWAP Filters"
use_vwap = input.bool(true, "Require Above Shifted Intraday VWAP", group=grp_vol)
rvol_min = input.float(1.20, "Minimum Relative Volume (RVOL)", step=0.1, group=grp_vol)
clv_min  = input.float(0.55, "Minimum Close Location Value (CLV)", step=0.05, group=grp_vol)

grp_trd  = "3. Macro Trend Filter"
use_ema  = input.bool(true, "Macro 200 EMA Filter", group=grp_trd)

grp_risk = "4. Dynamic Risk & Ratchet"
sl_mult  = input.float(1.40, "Initial Stop Loss (x ATR)", step=0.1, group=grp_risk)
p1_trig  = input.float(1.80, "Phase 1 Profit Lock Trigger (x ATR)", step=0.1, group=grp_risk)
p1_lock  = input.float(0.90, "Phase 1 Profit Floor (x ATR)", step=0.1, group=grp_risk)
p2_trig  = input.float(2.80, "Phase 2 Profit Lock Trigger (x ATR)", step=0.1, group=grp_risk)
p2_lock  = input.float(1.80, "Phase 2 Profit Floor (x ATR)", step=0.1, group=grp_risk)
tp_mult  = input.float(4.50, "Take Profit Target (x ATR)", step=0.5, group=grp_risk)

// ==============================================================================
// 2. INDICATORS
// ==============================================================================
// UT Bot
atr_ut = ta.atr(c_per)
nLoss  = a_mult * atr_ut
var float xATRTrailingStop = 0.0
prevStop = nz(xATRTrailingStop[1], 0.0)

if close > prevStop and close[1] > prevStop
    xATRTrailingStop := math.max(prevStop, close - nLoss)
else if close < prevStop and close[1] < prevStop
    xATRTrailingStop := math.min(prevStop, close + nLoss)
else if close > prevStop
    xATRTrailingStop := close - nLoss
else
    xATRTrailingStop := close + nLoss

plot(xATRTrailingStop, "UT Trailing Stop", color=close > xATRTrailingStop ? color.green : color.red, linewidth=2)

// Macro 200 EMA
ema200 = ta.ema(close, 200)
plot(ema200, "Macro 200 EMA", color=color.orange, linewidth=2)

// Intraday VWAP
vwap_val = ta.vwap(hlc3)
plot(vwap_val, "Intraday VWAP", color=color.purple, linewidth=1)

// Relative Volume & CLV
vol_ma20 = ta.sma(volume, 20)
rvol = volume / (vol_ma20 + 1e-6)
bar_rng = high - low + 1e-6
clv = ((close - low) - (high - close)) / bar_rng

// Volatility ATR
atr14 = ta.atr(14)

// ==============================================================================
// 3. EXECUTION
// ==============================================================================
buy_cross = ta.crossover(close, xATRTrailingStop)
sell_cross = ta.crossunder(close, xATRTrailingStop)

vwap_ok = not use_vwap or (close > vwap_val[1])
ema_ok  = not use_ema or (close > ema200)
vol_ok  = (rvol >= rvol_min) and (clv >= clv_min)

entry_cond = buy_cross and vwap_ok and ema_ok and vol_ok

var float active_sl = na
var float active_tp = na
var float high_seen = na
var int phase = 0

if entry_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    active_sl := close - (atr14 * sl_mult)
    active_tp := close + (atr14 * tp_mult)
    high_seen := high
    phase := 0

if strategy.position_size > 0
    high_seen := math.max(high_seen, high)
    entry_p = strategy.position_avg_price
    mfe_atr = (high_seen - entry_p) / atr14
    
    // Multi-Phase Ratchet
    if mfe_atr >= p2_trig and phase < 2
        phase := 2
        active_sl := math.max(active_sl, entry_p + (p2_lock * atr14))
    else if mfe_atr >= p1_trig and phase < 1
        phase := 1
        active_sl := math.max(active_sl, entry_p + (p1_lock * atr14))
        
    if high >= active_tp
        strategy.close("Long", comment="TP Target Hit")
    else if low <= active_sl
        strategy.close("Long", comment="SL/Ratchet Hit")
    else if sell_cross
        strategy.close("Long", comment="UT Stop Cross")
