//@version=6
strategy("Bhavishya V35 Tri-Slot Multi-Wave Compounding Engine", overlay=true, initial_capital=500, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20)

// =============================================================================
// BHAVISHYA V35 — TRI-SLOT MULTI-STAGE FREEROLL COMPOUNDING ENGINE (PINE V6)
// =============================================================================

// 1. Core Indicators
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema110 = ta.ema(close, 110)

atr14 = ta.atr(14)
atr_pct = (atr14 / close) * 100.0

rsi7 = ta.rsi(close, 7)
vwap_raw = ta.vwap(hlc3)
vwap_lag = vwap_raw[1]

vol_sma20 = ta.sma(volume, 20)
rvol = volume / (vol_sma20 + 1e-9)

change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / (volat10 + 1e-9)

// Candle Body Density & CLV
body10 = math.sum(math.abs(close - open), 10)
range10 = math.sum(high - low, 10) + 1e-6
d_body10 = body10 / range10
clv = (close - low) / (high - low + 1e-6)

// Friction Gate
f_rupee = 0.05 + 0.00206 * close
gamma_friction = f_rupee / (atr14 + 1e-9)

mom_long = close > close[math.min(300, bar_index)]
session_ok = not na(time(timeframe.period, "0920-1415"))
squareoff_time = not na(time(timeframe.period, "1445-1510"))

// Universal Microstructure Gate
micro_gate = (gamma_friction <= 0.28) and (atr14 >= 0.25) and (d_body10 >= 0.40) and (clv >= 0.50)

// Triggers
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
trig_t1 = ta.crossover(macdLine, signalLine) and (macdLine > 0) and (close > ema20) and (rsi7 > 50.0) and (er10 >= 0.35) and (rvol >= 1.20)

// Sharpened Trigger 2 (Pullback Re-Accumulation: 09:45-13:15, RVOL >= 1.20)
t2_time_ok = not na(time(timeframe.period, "0945-1315"))
sup_prev = math.max(ema9[1], vwap_lag[1]) + (0.15 * atr14)
trig_t2 = t2_time_ok and (macdLine > signalLine) and (macdLine > 0) and (ema9 > ema20) and (ema20 > ema50) and (close > ema9) and (low[1] <= sup_prev) and (volume[1] < volume[2]) and (volume >= 1.15 * volume[1]) and (rvol >= 1.20) and (close > high[1]) and (close[1] <= high[2]) and (close > open) and (rsi7 >= 52.0) and (rsi7 <= 74.0) and (((close - ema20) / atr14) <= 2.10)

univ_cond = (close > ema50) and (close > ema110) and (close > vwap_lag) and (atr_pct >= 0.50) and mom_long and (close <= 2500.0) and (close >= 15.0)

entry_cond = session_ok and univ_cond and micro_gate and (trig_t1 or trig_t2)

var float active_sl = na
var float high_seen = na
var float entry_atr_val = na
var int bars_held = 0

if (entry_cond and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    active_sl := close - (0.90 * atr14)
    high_seen := close
    entry_atr_val := atr14
    bars_held := 0

if (strategy.position_size > 0)
    bars_held := bars_held + 1
    high_seen := math.max(high_seen, high[1])
    mfe_atr = (high_seen - strategy.position_avg_price) / (entry_atr_val + 1e-9)
    
    // 4-Bar Scratch Rule
    if (bars_held >= 4 and mfe_atr < 0.40 and close < strategy.position_avg_price and (rsi7 < 46.0 or close < vwap_lag))
        active_sl := math.max(active_sl, close)
    
    // Volatility-Adaptive Elastic Ratchet
    nu = math.min(1.65, math.max(1.00, atr14 / (entry_atr_val + 1e-9)))
    
    if (mfe_atr >= 0.85 and mfe_atr < 1.15)
        active_sl := math.max(active_sl, strategy.position_avg_price + (0.40 * entry_atr_val))
    else if (mfe_atr >= 1.15 and mfe_atr < 2.00)
        active_sl := math.max(active_sl, high_seen - (0.28 * entry_atr_val))
    else if (mfe_atr >= 2.00 and mfe_atr < 3.00)
        active_sl := math.max(active_sl, high_seen - (0.20 * entry_atr_val))
    else if (mfe_atr >= 3.00)
        is_climax = (rvol >= 2.60 and (high - close) / (high - low + 1e-6) >= 0.45) or (rsi7 >= 86.0) or (close < low[1] and close < ema9) or (mfe_atr >= 8.00)
        if (is_climax)
            active_sl := math.max(active_sl, high_seen - (0.08 * entry_atr_val))
        else if (close >= ema9)
            active_sl := math.max(active_sl, math.max(high_seen - (0.26 * nu * entry_atr_val), math.min(low[1], low[2]) - (0.08 * entry_atr_val)))
        else
            active_sl := math.max(active_sl, high_seen - (0.18 * entry_atr_val))
            
    if (mfe_atr >= 0.85 and close < ema9 and rsi7 < 55.0)
        active_sl := active_sl + (0.05 * entry_atr_val)

    strategy.exit("Exit Long", "Long", stop=active_sl)

if (squareoff_time)
    strategy.close_all("EOD")
