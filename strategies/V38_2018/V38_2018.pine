//@version=6
strategy("Bhavishya V38 Master Universal Defense Quant Engine", overlay=true, initial_capital=500, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20)

// =============================================================================
// BHAVISHYA V38: MASTER UNIVERSAL DEFENSE QUANT ENGINE (PINE V6)
// =============================================================================
// Enhancements over V37:
// 1. Universal 2-Session Lockout on Hard Stop-Loss exits.
// 2. High-conviction selective alpha triggers (T1_TQS morning breakout + T2 structural pullback).
// 3. Asymmetric Elastic Runner Channel trailing stops for full trend expansion.
// =============================================================================

// 1. Moving Averages & Trend Filters
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema110 = ta.ema(close, 110)

// 2. Volatility & Efficiency Indicators
atr14 = ta.atr(14)
atr_pct = (atr14 / close) * 100.0

rsi7 = ta.rsi(close, 7)
vwap_raw = ta.vwap(hlc3)
vwap_lag = vwap_raw[1]

vol_sma20 = ta.sma(volume, 20)
rvol = volume / (vol_sma20 + 1e-9)

change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / (volat10 + 1e-9)

[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
[diplus, diminus, adx] = ta.dmi(10, 10)

mom_long = close > close[math.min(300, bar_index)]
session_ok = not na(time(timeframe.period, "0920-1415"))
squareoff_time = not na(time(timeframe.period, "1445-1510"))

// 3. Selective Alpha Triggers
// Trigger 1 (Primary Wave: Base & High-Conviction TQS Breakout)
macd_cross_up = ta.crossover(macdLine, signalLine)
t1_base = macd_cross_up and (macdLine > 0) and (close > ema20) and (rsi7 > 50.0) and (adx >= 18.0) and (diplus > diminus) and (er10 >= 0.35) and (rvol >= 1.20)
h_5 = ta.highest(high, 5)[1]
trig_t1_tqs = t1_base and (rvol >= 1.25) and (close > h_5)

// Trigger 2 (Structural Pullback Re-Accumulation: Close > EMA9, RVOL >= 1.15)
t2_time = not na(time(timeframe.period, "0945-1415"))
sup_prev = math.max(ema9[1], vwap_lag) + (0.22 * atr14)
l_min2 = math.min(low[1], low[2])
v_min2 = math.min(volume[1], volume[2])
v_max2_prev = math.max(volume[2], volume[3])
trig_t2 = t2_time and (macdLine > signalLine) and (macdLine > 0) and (diplus > diminus) and (close > ema9) and (l_min2 <= sup_prev) and (v_min2 < v_max2_prev) and (volume >= 1.12 * volume[1]) and (rvol >= 1.15) and (close > high[1]) and (close > open) and (close[1] <= high[2]) and (rsi7 >= 52.0) and (rsi7 <= 75.0) and (((close - ema20) / (atr14 + 1e-9)) <= 2.15)

// 4. Universe Qualification
univ_cond = (close > ema50) and (close > ema110) and (close > vwap_lag) and (atr_pct >= 0.50) and mom_long and (close <= 450.0) and (close >= 10.0)

// 5. 2-Session Hard-Stop Lockout State
var int last_sl_day = -999
cur_day = dayofmonth(time)
is_locked_out = (cur_day - last_sl_day <= 2) and (cur_day >= last_sl_day)

entry_cond = session_ok and univ_cond and (t1_base or trig_t1_tqs or trig_t2) and not is_locked_out

// 6. Position Sizing & Elastic Runner Trailing Stop Channel
var float active_sl = na
var float high_seen = na
var float entry_atr = na
var int bars_held = 0

if (entry_cond and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    entry_atr := atr14
    active_sl := close - (0.90 * atr14)
    high_seen := close
    bars_held := 0

if (strategy.position_size > 0)
    bars_held := bars_held + 1
    high_seen := math.max(high_seen, high[1])
    mfe_atr = (high_seen - strategy.position_avg_price) / (entry_atr + 1e-9)

    // Climax & Dynamic Nu Expansion
    shooting_star = (rvol >= 2.60) and (((high - close) / (high - low + 1e-6)) >= 0.45)
    extreme_rsi = (rsi7 >= 86.0)
    break_ema9 = (close < low[1]) and (close < ema9)
    circuit_prox = (mfe_atr >= 8.50)
    psi_climax = shooting_star or extreme_rsi or break_ema9 or circuit_prox

    theta_expand = (close > ema9) and (ema9 > ema20) and (adx >= 25.0 or rvol >= 2.0) and (rsi7 >= 58.0) and (not psi_climax)
    nu = math.min(1.65, math.max(1.0, atr14 / (entry_atr + 1e-9)))

    // 4-Bar Scratch Rule
    if (bars_held >= 4 and mfe_atr < 0.40 and close < strategy.position_avg_price and (rsi7 < 46.0 or close < vwap_lag))
        active_sl := math.max(active_sl, close)

    // Asymmetric Elastic Runner Channel
    if (mfe_atr >= 2.50)
        if (psi_climax)
            active_sl := math.max(active_sl, high_seen - (0.08 * entry_atr))
        else if (theta_expand)
            active_sl := math.max(active_sl, math.max(strategy.position_avg_price + 1.00 * entry_atr, math.max(math.min(low[1], low[2]) - 0.08 * entry_atr, high_seen - (0.36 * nu * entry_atr))))
        else
            active_sl := math.max(active_sl, high_seen - (0.18 * entry_atr))
    else if (mfe_atr >= 1.25)
        if (theta_expand)
            active_sl := math.max(active_sl, math.max(strategy.position_avg_price + 0.55 * entry_atr, math.max(math.min(low[1], low[2]) - 0.10 * entry_atr, high_seen - (0.50 * entry_atr))))
        else
            active_sl := math.max(active_sl, high_seen - (0.28 * entry_atr))
    else if (mfe_atr >= 0.85)
        active_sl := math.max(active_sl, strategy.position_avg_price + (0.40 * entry_atr))
    else
        active_sl := math.max(active_sl, strategy.position_avg_price - (0.90 * entry_atr))

    // Record Hard SL exit for 2-session lockout
    if (low <= active_sl and active_sl < strategy.position_avg_price)
        last_sl_day := cur_day

    strategy.exit("Exit Long", "Long", stop=active_sl)

if (squareoff_time)
    strategy.close_all("EOD")
