//@version=6
strategy("Bhavishya V23 Intraday", overlay=true, margin_long=20, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1)

// Causal indicators
ema50 = ta.ema(close, 50)
ema110 = ta.ema(close, 110)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
rsi7 = ta.rsi(close, 7)
[diPlus, diMinus, adxVal] = ta.dmi(10, 10)
atr14 = ta.atr(14)
vwapPrev = ta.vwap[1]

// V23 New Calibrated Filters
er10 = math.abs(close - close[10]) / (math.sum(math.abs(ta.change(close)), 10) + 1e-9)
rvol = volume / (ta.sma(volume, 20) + 1e-9)
atrPct = (atr14 / close) * 100.0
mom20d = close > close[300]

entryCond = (macdLine > signalLine) and (signalLine > 0) and (rsi7 > 50) and (adxVal >= 18) and (diPlus > diMinus) and (close > ema50) and (ema50 > ema110) and (close > vwapPrev) and (er10 >= 0.35) and (rvol >= 1.2) and (atrPct >= 0.50) and mom20d and (close >= 10.0) and (close <= 450.0)

sessionCond = time(timeframe.period, "0920-1415:23456")
flatCond = time(timeframe.period, "1445-1510:23456")

if (entryCond and sessionCond and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)

if (flatCond)
    strategy.close("Long", comment="EOD")
