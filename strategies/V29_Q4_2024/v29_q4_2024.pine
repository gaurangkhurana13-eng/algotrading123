//@version=6
strategy("Bhavishya V29 Holy Grail Hybrid", overlay=true, initial_capital=500, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20)

// =============================================================================
// BHAVISHYA V29 — HOLY GRAIL HYBRID ENGINE (PINE SCRIPT V6)
// =============================================================================

// 1. Indicators
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema60 = ta.ema(close, 60)
ema110 = ta.ema(close, 110)

atr14 = ta.atr(14)
atr_pct = (atr14 / close) * 100.0

rsi7 = ta.rsi(close, 7)
vwap_raw = ta.vwap(hlc3)
vwap_lag = vwap_raw[1]

vol_sma20 = ta.sma(volume, 20)
rvol = volume / (vol_sma20 + 1e-9)

change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / (volat10 + 1e-9)

mom_long = close > close[math.min(300, bar_index)]
session_ok = not na(time(timeframe.period, "0920-1415"))
squareoff_time = not na(time(timeframe.period, "1445-1510"))

entry_cond = (
     session_ok and
     (close > ema50) and (close > ema110) and (close > ema9) and (close > ema60) and
     (close > vwap_lag) and
     (er10 >= 0.35) and
     (rsi7 >= 48.0) and (rsi7 <= 78.0) and
     (rvol >= 1.2) and
     (atr_pct >= 0.50) and
     mom_long and
     (close <= 450.0) and (close >= 10.0)
 )

var float active_sl = na
var float high_seen = na

if (entry_cond and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    active_sl := close - (0.90 * atr14)
    high_seen := close

if (strategy.position_size > 0)
    high_seen := math.max(high_seen, high[1])
    mfe_atr = (high_seen - strategy.position_avg_price) / (atr14 + 1e-9)
    if (mfe_atr >= 4.00)
        active_sl := math.max(active_sl, high_seen - (0.10 * atr14))
    else if (mfe_atr >= 3.00)
        active_sl := math.max(active_sl, high_seen - (0.14 * atr14))
    else if (mfe_atr >= 2.00)
        active_sl := math.max(active_sl, high_seen - (0.20 * atr14))
    else if (mfe_atr >= 1.50)
        active_sl := math.max(active_sl, high_seen - (0.25 * atr14))
    else if (mfe_atr >= 1.15)
        active_sl := math.max(active_sl, high_seen - (0.28 * atr14))
    else if (mfe_atr >= 0.85)
        active_sl := math.max(active_sl, strategy.position_avg_price + (0.40 * atr14))
    strategy.exit("Exit Long", "Long", stop=active_sl)

if (squareoff_time)
    strategy.close_all("EOD")
