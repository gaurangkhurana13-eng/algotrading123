//@version=6
strategy("Bhavishya V26 Quant Engine", overlay=true, initial_capital=500, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20)

// =============================================================================
// BHAVISHYA V26 — QUANTITATIVE INTRADAY ENGINE (PINE SCRIPT V6)
// =============================================================================

// 1. Indicators
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema60 = ta.ema(close, 60)
ema110 = ta.ema(close, 110)

atr14 = ta.atr(14)
atr_pct = (atr14 / close) * 100.0

// RSI 7
rsi7 = ta.rsi(close, 7)

// MACD (12, 26, 9)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
macd_cross_up = ta.crossover(macdLine, signalLine) and macdLine > 0

// DMI / ADX 10
[diplus, diminus, adx] = ta.dmi(10, 10)

// Causal Session VWAP (Shifted by 1 bar to eliminate lookahead)
vwap_raw = ta.vwap(hlc3)
vwap_lag = vwap_raw[1]
vwap_slope = vwap_lag - vwap_lag[2]

// RVOL
vol_sma20 = ta.sma(volume, 20)
rvol = volume / (vol_sma20 + 1e-9)

// Kaufman Efficiency Ratio 10
change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / (volat10 + 1e-9)

// Multi-day Structural Momentum
mom_cond = close > close[math.min(300, bar_index)]

// 2. Entry Logic (All Causal, Zero Lookahead)
session_ok = not na(time(timeframe.period, "0920-1415"))
squareoff_time = not na(time(timeframe.period, "1445-1510"))

entry_cond = (
     macd_cross_up and
     close > ema50 and close > ema110 and
     close > vwap_lag and vwap_slope > 0 and
     rsi7 > 50.0 and adx >= 18.0 and diplus > diminus and
     er10 >= 0.35 and rvol >= 1.2 and atr_pct >= 0.50 and
     mom_cond and close >= 10.0 and close <= 450.0 and
     session_ok
     )

// 3. Execution & Dynamic Ratchet Trailing Ladder
var float entry_price = na
var float active_sl = na
var float initial_sl = na
var float high_seen = na
var int bars_held = 0

if (strategy.position_size == 0 and entry_cond)
    entry_price := close
    high_seen := close
    bars_held := 0
    initial_sl := close - (0.90 * atr14)
    active_sl := initial_sl
    strategy.entry("Long", strategy.long)

if (strategy.position_size > 0)
    bars_held := bars_held + 1
    high_seen := math.max(high_seen, high)
    mfe_atr = (high_seen - entry_price) / atr14
    
    // V26 Extended Ratchet Ladder
    float ladder_sl = active_sl
    if (mfe_atr >= 3.00)
        ladder_sl := high_seen - (0.14 * atr14)
    else if (mfe_atr >= 2.00)
        ladder_sl := high_seen - (0.20 * atr14)
    else if (mfe_atr >= 1.15)
        ladder_sl := high_seen - (0.28 * atr14)
    else if (mfe_atr >= 0.85)
        ladder_sl := entry_price + (0.40 * atr14)
    else
        ladder_sl := entry_price - (0.90 * atr14)
        
    // Velocity decay tightening
    if (mfe_atr >= 0.85 and close < ema9 and rsi7 < 55.0)
        ladder_sl := ladder_sl + (0.05 * atr14)
        
    active_sl := math.max(active_sl, ladder_sl)
    
    // Stagnation scratch at 4 bars
    stag_exit = (bars_held >= 4 and mfe_atr < 0.40 and close < entry_price and (rsi7 < 46.0 or close < vwap_lag))
    
    if (stag_exit)
        strategy.close("Long", comment="STAG")
    else if (squareoff_time)
        strategy.close("Long", comment="EOD")
    else
        strategy.exit("Exit Long", "Long", stop=active_sl)

if (strategy.position_size == 0)
    entry_price := na
    active_sl := na
    initial_sl := na
    high_seen := na
    bars_held := 0
