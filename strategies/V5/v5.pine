//@version=6
strategy("Bhavishya Strategy V5 - Precision Squeeze & Adaptive Moonshot Engine", 
         shorttitle="BHAVISHYA V5 [ApexMoonshot]", 
         overlay=true, 
         initial_capital=500, 
         default_qty_type=strategy.cash, 
         default_qty_value=500, 
         margin_long=20,
         commission_type=strategy.commission.cash_per_order, 
         commission_value=1.50, 
         slippage=1, 
         precision=2)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
grp_macd = "1. MACD Momentum Settings"
fast_len = input.int(12, "Fast EMA Length", minval=2, group=grp_macd)
slow_len = input.int(26, "Slow EMA Length", minval=5, group=grp_macd)
sig_len  = input.int(9, "Signal Length", minval=1, group=grp_macd)

grp_rsi  = "2. RSI & ADX Filters"
rsi_len  = input.int(7, "Fast RSI Length", minval=2, group=grp_rsi)
rsi_min  = input.float(50.0, "Minimum RSI Bullish Threshold", minval=40.0, maxval=70.0, group=grp_rsi)
adx_len  = input.int(10, "ADX Period", minval=5, group=grp_rsi)
adx_min  = input.float(18.0, "Minimum ADX Trend Strength", minval=10.0, maxval=40.0, group=grp_rsi)

grp_vwap = "3. Institutional VWAP Anchor"
use_vwap = input.bool(true, "Require Close > Shifted VWAP", group=grp_vwap)

grp_risk = "4. Precision Moonshot Trailing Ratchet"
sl_mult  = input.float(1.00, "Initial Stop Loss (x ATR)", step=0.05, group=grp_risk)
p1_trig  = input.float(0.85, "Phase 1 Lock Trigger (x ATR)", step=0.05, group=grp_risk)
p1_lock  = input.float(0.45, "Phase 1 Profit Floor (x ATR)", step=0.05, group=grp_risk)
p2_trig  = input.float(1.70, "Phase 2 Moonshot Trigger (x ATR)", step=0.05, group=grp_risk)
trail_dist = input.float(0.60, "Phase 2 Dynamic Trail Distance (x ATR)", step=0.05, group=grp_risk)

// ==============================================================================
// 2. INDICATOR ENGINE
// ==============================================================================
// Macro 50 EMA
ema50 = ta.ema(close, 50)
plot(ema50, "Macro 50 EMA", color=color.orange, linewidth=2)

// Intraday VWAP (Causal shifted by 1 bar to prevent bar-close peeking)
vwap_val = ta.vwap(hlc3)
plot(vwap_val, "Intraday VWAP", color=color.purple, linewidth=1)

// Volatility ATR 14
atr14 = ta.atr(14)

// MACD Zero-Line System
[macdLine, signalLine, hist] = ta.macd(close, fast_len, slow_len, sig_len)
macd_cross = ta.crossover(macdLine, signalLine)
macd_bull  = macdLine > 0

// Fast RSI 7
rsi_val = ta.rsi(close, rsi_len)

// ADX & Directional Movement
[plus_di, minus_di, adx_val] = ta.dmi(adx_len, adx_len)
trend_active = (adx_val > adx_min) and (plus_di > minus_di)

// Bollinger & Keltner Squeeze Indicator
bb_mid = ta.sma(close, 20)
bb_dev = 2.0 * ta.stdev(close, 20)
bb_up  = bb_mid + bb_dev
bb_dn  = bb_mid - bb_dev
kc_up  = bb_mid + 1.5 * atr14
kc_dn  = bb_mid - 1.5 * atr14
squeeze_on = (bb_up < kc_up) and (bb_dn > kc_dn)

// Background highlight for volatility squeeze
bgcolor(squeeze_on ? color.new(color.orange, 90) : na, title="Squeeze Energy Coiling")

// ==============================================================================
// 3. EXECUTION & PRECISION MOONSHOT TRAILING
// ==============================================================================
time_ok = (hour > 9 or (hour == 9 and minute >= 20)) and (hour < 13 or (hour == 13 and minute <= 30))
vwap_ok = not use_vwap or (close > vwap_val[1])

entry_condition = macd_cross and macd_bull and (close > ema50) and (rsi_val > rsi_min) and trend_active and vwap_ok and time_ok

var float active_sl = na
var float high_seen = na
var float entry_atr = na
var int phase = 0

if entry_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    entry_atr := atr14
    active_sl := close - (sl_mult * entry_atr)
    high_seen := high
    phase := 0

if strategy.position_size > 0
    high_seen := math.max(high_seen, high)
    entry_p = strategy.position_avg_price
    mfe_atr = (high_seen - entry_p) / entry_atr
    
    // Phase 1: Lock +0.45x ATR profit early at +0.85x ATR
    if mfe_atr >= p1_trig and phase < 1
        phase := 1
        active_sl := math.max(active_sl, entry_p + (p1_lock * entry_atr))
        
    // Phase 2: Moonshot Trail - let runners run by trailing 0.60x ATR behind HighSeen
    if mfe_atr >= p2_trig
        phase := 2
        active_sl := math.max(active_sl, high_seen - (trail_dist * entry_atr))
        
    // Stop / Ratchet Floor Hit
    if low <= active_sl
        strategy.close("Long", comment="Ratchet/Trail Hit")

// 15:10 IST Intraday Square-off
if (hour == 15 and minute >= 10) or (hour > 15)
    strategy.close_all("15:10 MIS Square-Off")

plot(strategy.position_size > 0 ? active_sl : na, "Precision Moonshot Floor", color=color.green, style=plot.style_linebr, linewidth=2)
