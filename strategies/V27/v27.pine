//@version=6
strategy("Bhavishya V27 Bi-Directional Engine", overlay=true, initial_capital=500, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20, margin_short=20)

// 1. Indicators
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema60 = ta.ema(close, 60)
ema110 = ta.ema(close, 110)

atr14 = ta.atr(14)
atr_pct = (atr14 / close) * 100.0

rsi7 = ta.rsi(close, 7)
vwap_raw = ta.vwap(hlc3)
vwap_lag = vwap_raw[1]

vol_sma20 = ta.sma(volume, 20)
rvol = volume / (vol_sma20 + 1e-9)

change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / (volat10 + 1e-9)

mom_long = close > close[math.min(300, bar_index)]
mom_short = close < close[math.min(300, bar_index)]

session_ok = not na(time(timeframe.period, "0920-1415"))
squareoff_time = not na(time(timeframe.period, "1445-1510"))

g4_long = (close > ema50) and (close > ema110) and (close > ema9) and (close > ema60) and (close > vwap_lag) and (er10 >= 0.35) and (rsi7 >= 48.0) and (rsi7 <= 78.0) and (rvol >= 1.2) and (atr_pct >= 0.50) and mom_long and (close <= 450.0) and (close >= 10.0)

g4_short = (close < ema50) and (close < ema110) and (close < ema9) and (close < ema60) and (close < vwap_lag) and (er10 >= 0.35) and (rsi7 <= 52.0) and (rsi7 >= 22.0) and (rvol >= 1.2) and (atr_pct >= 0.50) and mom_short and (close <= 450.0) and (close >= 10.0)

var float long_sl = na
var float short_sl = na
var float high_seen = na
var float low_seen = na

if (session_ok and g4_long and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    long_sl := close - (0.90 * atr14)
    high_seen := close

if (session_ok and g4_short and strategy.position_size == 0)
    strategy.entry("Short", strategy.short)
    short_sl := close + (0.90 * atr14)
    low_seen := close

if (strategy.position_size > 0)
    high_seen := math.max(high_seen, high[1])
    mfe_atr = (high_seen - strategy.position_avg_price) / (atr14 + 1e-9)
    if (mfe_atr >= 3.00)
        long_sl := math.max(long_sl, high_seen - (0.14 * atr14))
    else if (mfe_atr >= 2.00)
        long_sl := math.max(long_sl, high_seen - (0.20 * atr14))
    else if (mfe_atr >= 1.15)
        long_sl := math.max(long_sl, high_seen - (0.28 * atr14))
    else if (mfe_atr >= 0.85)
        long_sl := math.max(long_sl, strategy.position_avg_price + (0.40 * atr14))
    strategy.exit("Exit Long", "Long", stop=long_sl)

if (strategy.position_size < 0)
    low_seen := math.min(low_seen, low[1])
    mfe_atr = (strategy.position_avg_price - low_seen) / (atr14 + 1e-9)
    if (mfe_atr >= 3.00)
        short_sl := math.min(short_sl, low_seen + (0.14 * atr14))
    else if (mfe_atr >= 2.00)
        short_sl := math.min(short_sl, low_seen + (0.20 * atr14))
    else if (mfe_atr >= 1.15)
        short_sl := math.min(short_sl, low_seen + (0.28 * atr14))
    else if (mfe_atr >= 0.85)
        short_sl := math.min(short_sl, strategy.position_avg_price - (0.40 * atr14))
    strategy.exit("Exit Short", "Short", stop=short_sl)

if (squareoff_time)
    strategy.close_all("EOD")
