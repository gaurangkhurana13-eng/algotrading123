//@version=6
strategy("Bhavishya V37 Master Alpha Compounding Engine", overlay=true, initial_capital=500, default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20)

// =============================================================================
// BHAVISHYA V37: MASTER MULTI-WAVE ALPHA COMPOUNDING ENGINE (PINE V6)
// =============================================================================

// 1. Moving Averages & Trend Filters
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema110 = ta.ema(close, 110)

// 2. Volatility & Efficiency Indicators
atr14 = ta.atr(14)
atr_pct = (atr14 / close) * 100.0

rsi7 = ta.rsi(close, 7)
vwap_raw = ta.vwap(hlc3)
vwap_lag = vwap_raw[1]

vol_sma20 = ta.sma(volume, 20)
rvol = volume / (vol_sma20 + 1e-9)

change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / (volat10 + 1e-9)

[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
[diplus, diminus, adx] = ta.dmi(10, 10)

mom_long = close > close[math.min(300, bar_index)]
session_ok = not na(time(timeframe.period, "0920-1415"))
squareoff_time = not na(time(timeframe.period, "1445-1510"))

// 3. Tri-Wave Triggers
// Trigger 1A: Primary MACD Cross-Up
trig_t1a = ta.crossover(macdLine, signalLine) and (macdLine > 0) and (close > ema20) and (rsi7 > 50.0) and (adx >= 18.0) and (diplus > diminus) and (er10 >= 0.35) and (rvol >= 1.20)

// Trigger 1B: Morning ORB Momentum Drive (09:20 - 11:00) with Calibrated RVOL >= 1.50
t1b_time = not na(time(timeframe.period, "0920-1100"))
h_max2 = math.max(high[1], high[2])
h_max2_prev = math.max(high[2], high[3])
trig_t1b = t1b_time and (macdLine > signalLine) and (signalLine > 0) and (histLine > histLine[1]) and (close > h_max2) and (close[1] <= h_max2_prev) and (ema9 > ema20) and (ema20 > ema50) and (rsi7 >= 54.0) and (rsi7 <= 76.0) and (er10 >= 0.40) and (rvol >= 1.50) and (((close - ema9) / atr14) <= 1.80)

// Trigger 2: Structural Pullback Re-Accumulation (09:45 - 13:15)
t2_time = not na(time(timeframe.period, "0945-1315"))
sup_prev = math.max(ema9[1], vwap_lag) + (0.22 * atr14)
trig_t2 = t2_time and (macdLine > signalLine) and (macdLine > 0) and (diplus > diminus) and (close > ema9) and (math.min(low[1], low[2]) <= sup_prev) and (math.min(volume[1], volume[2]) < math.max(volume[2], volume[3])) and (volume >= 1.12 * volume[1]) and (rvol >= 1.15) and (close > high[1]) and (close > open) and (close[1] <= high[2]) and (rsi7 >= 52.0) and (rsi7 <= 75.0) and (((close - ema20) / atr14) <= 2.15)

// Trigger 3: Afternoon Volatility Squeeze Box (11:00 - 14:15)
t3_time = not na(time(timeframe.period, "1100-1415"))
h_box = ta.highest(high, 4)[1]
l_box = ta.lowest(low, 4)[1]
box_range = h_box - l_box
trig_t3 = t3_time and (box_range <= 1.65 * atr14) and (l_box >= vwap_lag - 0.15 * atr14) and (close > h_box) and (close[1] <= h_box) and (close > ema9) and (rvol >= 1.30) and (((close - low) / (high - low + 1e-6)) >= 0.60) and (macdLine >= signalLine) and (rsi7 >= 54.0) and (rsi7 <= 78.0)

// 4. Universe Qualification
univ_cond = (close > ema50) and (close > ema110) and (close > vwap_lag) and (atr_pct >= 0.50) and mom_long and (close <= 450.0) and (close >= 10.0)

entry_cond = session_ok and univ_cond and (trig_t1a or trig_t1b or trig_t2 or trig_t3)

// 5. Position Management & Elastic Runner Channel
var float active_sl = na
var float high_seen = na
var float entry_atr = na
var int bars_held = 0

if (entry_cond and strategy.position_size == 0)
    strategy.entry("Long", strategy.long)
    entry_atr := atr14
    active_sl := close - (0.90 * atr14)
    high_seen := close
    bars_held := 0

if (strategy.position_size > 0)
    bars_held := bars_held + 1
    high_seen := math.max(high_seen, high[1])
    mfe_atr = (high_seen - strategy.position_avg_price) / (entry_atr + 1e-9)

    // Climax & Expansion State
    shooting_star = (rvol >= 2.60) and (((high - close) / (high - low + 1e-6)) >= 0.45)
    extreme_rsi = (rsi7 >= 86.0)
    break_ema9 = (close < low[1]) and (close < ema9)
    circuit_prox = (mfe_atr >= 8.50)
    psi_climax = shooting_star or extreme_rsi or break_ema9 or circuit_prox

    theta_expand = (close > ema9) and (ema9 > ema20) and (adx >= 25.0 or rvol >= 2.0) and (rsi7 >= 58.0) and (not psi_climax)
    nu = math.min(1.65, math.max(1.0, atr14 / (entry_atr + 1e-9)))

    // 4-Bar Scratch Rule
    if (bars_held >= 4 and mfe_atr < 0.40 and close < strategy.position_avg_price and (rsi7 < 46.0 or close < vwap_lag))
        active_sl := math.max(active_sl, close)

    // V37 Asymmetric Elastic Runner Channel
    if (mfe_atr >= 2.50)
        if (psi_climax)
            active_sl := math.max(active_sl, high_seen - (0.08 * entry_atr))
        else if (theta_expand)
            active_sl := math.max(active_sl, math.max(strategy.position_avg_price + 1.00 * entry_atr, math.max(math.min(low[1], low[2]) - 0.08 * entry_atr, high_seen - (0.36 * nu * entry_atr))))
        else
            active_sl := math.max(active_sl, high_seen - (0.18 * entry_atr))
    else if (mfe_atr >= 1.25)
        if (theta_expand)
            active_sl := math.max(active_sl, math.max(strategy.position_avg_price + 0.55 * entry_atr, math.max(math.min(low[1], low[2]) - 0.10 * entry_atr, high_seen - (0.50 * entry_atr))))
        else
            active_sl := math.max(active_sl, high_seen - (0.28 * entry_atr))
    else if (mfe_atr >= 0.85)
        active_sl := math.max(active_sl, strategy.position_avg_price + (0.40 * entry_atr))
    else
        active_sl := math.max(active_sl, strategy.position_avg_price - (0.90 * entry_atr))

    strategy.exit("Exit Long", "Long", stop=active_sl)

if (squareoff_time)
    strategy.close_all("EOD")
