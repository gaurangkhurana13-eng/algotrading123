//@version=6
strategy("Bhavishya Strategy V9: Relative Strength & Moonshot Momentum Engine", 
         overlay=true, 
         initial_capital=500, 
         default_qty_type=strategy.cash, 
         default_qty_value=500, 
         commission_type=strategy.commission.cash_per_order, 
         commission_value=1.50, 
         slippage=1, 
         margin_long=20, 
         process_orders_on_close=true)

// =============================================================================
// 1. INPUT PARAMETERS & ASYMMETRIC RATCHET CONFIGURATION
// =============================================================================
grp_eng  = "Engine Parameters"
sl_mult   = input.float(1.00, "Initial Stop Loss (x ATR)", group=grp_eng, step=0.05)
p1_trig   = input.float(0.85, "Phase 1 Trigger (x ATR MFE)", group=grp_eng, step=0.05)
p1_lock   = input.float(0.40, "Phase 1 Profit Lock (x ATR Floor)", group=grp_eng, step=0.05)
p2_trig   = input.float(1.70, "Phase 2 Moonshot Trigger (x ATR MFE)", group=grp_eng, step=0.05)
trail_dst = input.float(0.65, "Phase 2 Trailing Distance (x ATR)", group=grp_eng, step=0.05)

grp_filt = "Trend & Momentum Indicators"
ema_len  = input.int(50, "Macro EMA Filter Length", group=grp_filt)
rsi_len  = input.int(7, "Fast RSI Length", group=grp_filt)
rsi_min  = input.float(50.0, "Fast RSI Minimum Level", group=grp_filt)
adx_len  = input.int(10, "ADX Smoothing Length", group=grp_filt)
adx_min  = input.float(18.0, "ADX Threshold Level", group=grp_filt)

// =============================================================================
// 2. QUANTITATIVE INDICATORS (STRICT NO-LOOKAHEAD EXECUTION)
// =============================================================================
// Shifted VWAP (Previous Session Anchor - Zero Intrabar Leakage)
vwap_val = ta.vwap(close)
vwap_lag = vwap_val[1]

// Macro Trend Gate
ema_trend = ta.ema(close, ema_len)

// MACD (12, 26, 9)
[macd_line, macd_sig, _] = ta.macd(close, 12, 26, 9)
macd_cross_up = ta.crossover(macd_line, macd_sig) and (macd_line > 0)

// Fast RSI 7
rsi_fast = ta.rsi(close, rsi_len)

// ADX & Directional Movement (10-Period)
[di_plus, di_minus, adx_val] = ta.dmi(adx_len, adx_len)

// 14-Period ATR for Volatility Sizing & Ratchet Protection
atr14 = ta.atr(14)

// =============================================================================
// 3. EXECUTION TIME WINDOW & 15:10 IST AUTO-SQUARE-OFF
// =============================================================================
cur_time = time("15", "0920-1330:23456")
entry_allowed = not na(cur_time)

// Intraday 15:10 Auto-Squareoff (Mandatory MIS flat rule)
time_to_close = (hour == 15 and minute >= 10) or (hour > 15)

// Entry Signal Confluence
long_condition = entry_allowed and macd_cross_up and (close > ema_trend) and (close > vwap_lag) and (rsi_fast > rsi_min) and (adx_val > adx_min) and (di_plus > di_minus)

// =============================================================================
// 4. POSITION MANAGEMENT & 2-PHASE MOONSHOT RATCHET STATE MACHINE
// =============================================================================
var float entry_price = 0.0
var float entry_atr   = 0.0
var float active_sl   = 0.0
var float high_seen   = 0.0
var int   ratchet_phase = 0

if (strategy.position_size == 0)
    if (long_condition)
        entry_price   := close
        entry_atr     := nz(atr14, close * 0.01)
        active_sl     := close - (sl_mult * entry_atr)
        high_seen     := close
        ratchet_phase := 0
        strategy.entry("Long_Entry", strategy.long)
else
    high_seen := math.max(high_seen, high)
    mfe_atr = (entry_atr > 0) ? (high_seen - entry_price) / entry_atr : 0.0

    // Phase 1: Breakeven Profit Lock
    if (mfe_atr >= p1_trig and ratchet_phase < 1)
        ratchet_phase := 1
        active_sl     := math.max(active_sl, entry_price + (p1_lock * entry_atr))

    // Phase 2: Dynamic Asymmetric Moonshot Trailing Stop
    if (mfe_atr >= p2_trig)
        ratchet_phase := 2
        active_sl     := math.max(active_sl, high_seen - (trail_dst * entry_atr))

    // Stop Loss Execution
    if (low <= active_sl)
        strategy.close("Long_Entry", comment="SL_OR_RATCHET_EXIT")

    // Mandatory 15:10 IST Auto-Squareoff
    if (time_to_close)
        strategy.close_all(comment="1510_INTRADAY_SQUAREOFF")

// Plot Key Support & Ratchet Levels
plot(strategy.position_size > 0 ? active_sl : na, "Active Ratchet Stop", color=color.red, style=plot.style_linebr, linewidth=2)
plot(vwap_lag, "Shifted VWAP Lag", color=color.blue, linewidth=1)
plot(ema_trend, "50 EMA Trend", color=color.orange, linewidth=1)
