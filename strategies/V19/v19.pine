//@version=6
strategy("Bhavishya Strategy V19: 3-Phase Asymmetric Dynamic Spline Engine", overlay=true, initial_capital=500, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.cash_per_order, commission_value=1.50, slippage=1, margin_long=20.0)

// --- Microstructure & Indicators ---
ema50 = ta.ema(close, 50)
ema110 = ta.ema(close, 110)
atr14 = ta.atr(14)
rsi7 = ta.rsi(close, 7)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macd_cross_up = ta.crossover(macdLine, signalLine) and (macdLine > 0)

// Directional Movement
[plusDI, minusDI, adx] = ta.dmi(10, 10)

// Efficiency Ratio & RVOL
change10 = math.abs(close - close[10])
volat10 = math.sum(math.abs(ta.change(close)), 10)
er10 = change10 / math.max(volat10, 1e-9)
v_sma20 = ta.sma(volume, 20)
rvol = volume / math.max(v_sma20, 1e-9)

// VWAP shifted
vwap_val = ta.vwap(hlc3)[1]

// Microstructure Filter
clv = (close - low) / math.max(high - low, 1e-9)

// Session filter (100% Intraday)
time_ok = (time(timeframe.period, "0920-1415") != 0)
squareoff_time = (time(timeframe.period, "1445-1510") != 0)

// Entry Condition
entry_cond = macd_cross_up and (close > ema50) and (close > ema110) and (close > vwap_val) and (rsi7 > 50.0) and (adx > 18.0) and (plusDI > minusDI) and (close <= 450.0) and time_ok

// Dynamic Conviction Multiplier
er_bonus = 0.25 * math.max(0.0, er10 - 0.35)
rvol_bonus = 0.05 * math.min(math.max(0.0, rvol - 1.5), 3.0)
weight = math.min(1.20, math.max(0.85, 0.85 + er_bonus + rvol_bonus))

// Decoupled Sizing & Stop
var float entry_price = 0.0
var float initial_sl = 0.0
var float active_sl = 0.0
var float high_seen = 0.0
var int bars_held = 0
var int phase = 0

if (entry_cond and strategy.position_size == 0)
    entry_price := close
    initial_sl := close - (0.90 * atr14)
    active_sl := initial_sl
    high_seen := high
    bars_held := 0
    phase := 0
    strategy.entry("Long_V19", strategy.long)

if (strategy.position_size > 0)
    bars_held := bars_held + 1
    high_seen := math.max(high_seen, high)
    mfe_atr = (high_seen - entry_price) / math.max(atr14, 1e-9)
    
    // 3-Phase Asymmetric Lifecycle
    if (mfe_atr >= 2.50 or (mfe_atr >= 1.25 and hour >= 14 and minute >= 15))
        active_sl := math.max(active_sl, high_seen - (0.20 * atr14))
        phase := 3
    else if (mfe_atr >= 1.15)
        active_sl := math.max(active_sl, high_seen - (0.28 * atr14))
        phase := 2
    else if (mfe_atr >= 0.85)
        active_sl := math.max(active_sl, entry_price + (0.40 * atr14))
        phase := 1

    // Stop exit
    if (low <= active_sl)
        strategy.close("Long_V19", comment="Stop / Trailing Stop")

    // Stagnation Scratch
    if (bars_held >= 3 and mfe_atr < 0.40 and close < entry_price and (rsi7 < 46.0 or close < vwap_val))
        strategy.close("Long_V19", comment="Stagnation Scratch")

    // Square-off
    if (squareoff_time)
        strategy.close("Long_V19", comment="Intraday Square-off")

plot(active_sl, "Active SL", color=color.red, style=plot.style_linebr)
plot(ema50, "EMA 50", color=color.blue)
plot(ema110, "EMA 110", color=color.orange)
