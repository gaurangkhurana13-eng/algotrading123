//@version=6
strategy("Bhavishya Strategy V1 - SVMKR + MAPO + HMA Confluence", 
         shorttitle="BHAVISHYA V1 [Confluence]", 
         overlay=true, 
         initial_capital=500, 
         default_qty_type=strategy.cash, 
         default_qty_value=500, 
         commission_type=strategy.commission.percent, 
         commission_value=0.03, 
         slippage=1, 
         precision=2)

// ==============================================================================
// 1. INPUTS
// ==============================================================================
grp_ut   = "1. SVMKR UT Bot Engine"
a_mult   = input.float(2.0, "Key Value Sensitivity", minval=0.5, step=0.1, group=grp_ut)
c_per    = input.int(1, "ATR Period", minval=1, group=grp_ut)

grp_hma  = "2. Hull Moving Average Trend"
hma_len  = input.int(31, "HMA Length", minval=5, group=grp_hma)

grp_mapo = "3. LuxAlgo MAPO Consensus"
mapo_th  = input.float(50.0, "Bullish MAPO Threshold (%)", minval=10.0, maxval=90.0, group=grp_mapo)

grp_risk = "4. Risk & Ratchet Settings"
sl_mult  = input.float(1.5, "Initial Stop Loss (x ATR)", step=0.1, group=grp_risk)
p1_trig  = input.float(1.8, "Phase 1 Profit Lock Trigger (x ATR)", step=0.1, group=grp_risk)
p1_lock  = input.float(0.8, "Phase 1 Profit Floor (x ATR)", step=0.1, group=grp_risk)
tp_mult  = input.float(4.0, "Take Profit Target (x ATR)", step=0.5, group=grp_risk)

// ==============================================================================
// 2. INDICATOR ENGINE
// ==============================================================================
// A. UT Bot ATR Trailing Stop
atr_ut = ta.atr(c_per)
nLoss  = a_mult * atr_ut
var float xATRTrailingStop = 0.0
prevStop = nz(xATRTrailingStop[1], 0.0)

if close > prevStop and close[1] > prevStop
    xATRTrailingStop := math.max(prevStop, close - nLoss)
else if close < prevStop and close[1] < prevStop
    xATRTrailingStop := math.min(prevStop, close + nLoss)
else if close > prevStop
    xATRTrailingStop := close - nLoss
else
    xATRTrailingStop := close + nLoss

plot(xATRTrailingStop, "UT Trailing Stop", color=close > xATRTrailingStop ? color.green : color.red, linewidth=2)

// B. Hull Moving Average
hma_calc = ta.hma(close, hma_len)
plot(hma_calc, "HMA 31", color=color.new(color.blue, 30), linewidth=2)

// C. MAPO Consensus (% of 19 MAs where close > MA)
int bull_mas = 0
for m = 10 to 100 by 5
    if close > ta.sma(close, m)
        bull_mas += 1
float mapo_pct = (bull_mas / 19.0) * 100.0

// D. 14-period Volatility ATR
atr14 = ta.atr(14)

// ==============================================================================
// 3. ENTRY & EXIT STATE MACHINE
// ==============================================================================
buy_cross = ta.crossover(close, xATRTrailingStop)
sell_cross = ta.crossunder(close, xATRTrailingStop)

// Confluence Entry: Cross above UT Bot + HMA Bullish + MAPO Consensus >= 50%
entry_cond = buy_cross and (close > hma_calc) and (mapo_pct >= mapo_th)

var float active_sl = na
var float active_tp = na
var float high_seen = na
var int phase = 0

if entry_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    active_sl := close - (atr14 * sl_mult)
    active_tp := close + (atr14 * tp_mult)
    high_seen := high
    phase := 0

if strategy.position_size > 0
    high_seen := math.max(high_seen, high)
    entry_p = strategy.position_avg_price
    mfe_atr = (high_seen - entry_p) / atr14
    
    // Profit Ratchet: Lock profit once price reaches +1.8 ATR
    if mfe_atr >= p1_trig and phase == 0
        phase := 1
        active_sl := math.max(active_sl, entry_p + (p1_lock * atr14))
        
    // Take Profit or Trailing Stop
    if high >= active_tp
        strategy.close("Long", comment="TP Hit")
    else if low <= active_sl
        strategy.close("Long", comment="SL/Ratchet Hit")
    else if sell_cross
        strategy.close("Long", comment="UT Stop Cross")
