//@version=6
strategy("Bhavishya Strategy V3 - Momentum Velocity & Asymmetric Ratchet Engine", 
         shorttitle="BHAVISHYA V3 [MomentumRatchet]", 
         overlay=true, 
         initial_capital=500, 
         default_qty_type=strategy.cash, 
         default_qty_value=500, 
         commission_type=strategy.commission.percent, 
         commission_value=0.03, 
         slippage=1, 
         precision=2)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
grp_macd = "1. MACD Momentum Settings"
fast_len = input.int(12, "Fast EMA Length", minval=2, group=grp_macd)
slow_len = input.int(26, "Slow EMA Length", minval=5, group=grp_macd)
sig_len  = input.int(9, "Signal Length", minval=1, group=grp_macd)

grp_rsi  = "2. RSI Momentum Filter"
rsi_len  = input.int(7, "RSI Length", minval=2, group=grp_rsi)
rsi_min  = input.float(52.0, "Minimum RSI Bullish Level", minval=40.0, maxval=70.0, group=grp_rsi)

grp_adx  = "3. ADX Trend Strength Filter"
adx_len  = input.int(10, "ADX Period", minval=5, group=grp_adx)
adx_min  = input.float(20.0, "Minimum ADX Trend Strength", minval=10.0, maxval=40.0, group=grp_adx)

grp_risk = "4. Asymmetric Profit Ratchet"
sl_mult  = input.float(1.00, "Initial Stop Loss (x ATR)", step=0.1, group=grp_risk)
p1_trig  = input.float(0.90, "Phase 1 Lock Trigger (x ATR)", step=0.1, group=grp_risk)
p1_lock  = input.float(0.30, "Phase 1 Profit Floor (x ATR)", step=0.05, group=grp_risk)
p2_trig  = input.float(2.00, "Phase 2 Lock Trigger (x ATR)", step=0.1, group=grp_risk)
p2_lock  = input.float(1.20, "Phase 2 Profit Floor (x ATR)", step=0.1, group=grp_risk)
tp_mult  = input.float(2.20, "Take Profit Target (x ATR)", step=0.1, group=grp_risk)

// ==============================================================================
// 2. INDICATORS
// ==============================================================================
// Macro 50 EMA
ema50 = ta.ema(close, 50)
plot(ema50, "Macro 50 EMA", color=color.orange, linewidth=2)

// Volatility ATR 14
atr14 = ta.atr(14)

// MACD Zero-Line System
[macdLine, signalLine, hist] = ta.macd(close, fast_len, slow_len, sig_len)
macd_cross = ta.crossover(macdLine, signalLine)
macd_bull  = macdLine > 0

// Fast 7-Period RSI
rsi_val = ta.rsi(close, rsi_len)

// ADX & Directional Movement
[plus_di, minus_di, adx_val] = ta.dmi(adx_len, adx_len)
trend_active = (adx_val > adx_min) and (plus_di > minus_di)

// ==============================================================================
// 3. CONFLUENCE ENTRY & DYNAMIC RATCHET EXECUTION
// ==============================================================================
time_ok = (hour > 9 or (hour == 9 and minute >= 20)) and (hour < 13 or (hour == 13 and minute <= 30))

entry_condition = macd_cross and macd_bull and (close > ema50) and (rsi_val > rsi_min) and trend_active and time_ok

var float active_sl = na
var float active_tp = na
var float high_seen = na
var float entry_atr = na
var int phase = 0

if entry_condition and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    entry_atr := atr14
    active_sl := close - (sl_mult * entry_atr)
    active_tp := close + (tp_mult * entry_atr)
    high_seen := high
    phase := 0

if strategy.position_size > 0
    high_seen := math.max(high_seen, high)
    entry_p = strategy.position_avg_price
    mfe_atr = (high_seen - entry_p) / entry_atr
    
    // Dynamic Ratchet: Locks profit early to convert noise pullbacks into wins
    if mfe_atr >= p2_trig and phase < 2
        phase := 2
        active_sl := math.max(active_sl, entry_p + (p2_lock * entry_atr))
    else if mfe_atr >= p1_trig and phase < 1
        phase := 1
        active_sl := math.max(active_sl, entry_p + (p1_lock * entry_atr))
        
    // Take Profit or Stop
    if high >= active_tp
        strategy.close("Long", comment="TP Hit (+2.2x ATR)")
    else if low <= active_sl
        strategy.close("Long", comment="Ratchet/SL Hit")

plot(strategy.position_size > 0 ? active_sl : na, "Active Ratchet Floor", color=color.green, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? active_tp : na, "Target Ceiling", color=color.blue, style=plot.style_linebr, linewidth=2)
