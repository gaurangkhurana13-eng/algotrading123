//@version=5
strategy("PC Jeweller 1m Live Predator [Official V3] Telegram", 
         overlay=true, 
         initial_capital=500, 
         currency=currency.INR, 
         commission_type=strategy.commission.cash_per_order, 
         commission_value=1.5,
         pyramiding=0)

// ==========================================
// 1. POSITION SIZING & DHAN 5X LEVERAGE
// ==========================================
useCompounding = input.bool(true, title="Enable Live Balance Compounding")
fixedLeverage  = input.float(5.0, title="Dhan MIS Leverage", minval=1.0, maxval=5.0)

currentPower = useCompounding ? (strategy.equity * fixedLeverage) : (500.0 * fixedLeverage)
calcQty      = math.max(1, math.floor(currentPower / close))

maxTradesPerDay = input.int(2, title="Max Sniper Shots Per Day", minval=1, maxval=2)

// ==========================================
// 2. TIMING & 30-MIN ORB SETUP (IST)
// ==========================================
isNewDay       = ta.change(time("D")) != 0
inOrbSession   = not na(time(timeframe.period, "0915-0945:1234567"))
inTradeSession = not na(time(timeframe.period, "0945-1445:1234567"))
isEOD          = not na(time(timeframe.period, "1515-1530:1234567"))

var float orbHigh   = na
var float orbLow    = na
var int tradesToday = 0

if isNewDay
    orbHigh     := na
    orbLow      := na
    tradesToday := 0

if inOrbSession
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow  := na(orbLow)  ? low  : math.min(orbLow, low)

plot(orbHigh, title="ORB High (09:45)", color=color.new(#00E676, 0), linewidth=2, style=plot.style_linebr)
plot(orbLow,  title="ORB Low (09:45)",  color=color.new(#FF5252, 0), linewidth=2, style=plot.style_linebr)

// ==========================================
// 3. INSTITUTIONAL FILTERS
// ==========================================
vwapVal  = ta.vwap(close)
dailyEma = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
volSma   = ta.sma(volume, 20)
volSpike = volume > volSma * 1.05

plot(vwapVal, title="VWAP", color=color.new(#29B6F6, 0), linewidth=2)

// ==========================================
// 4. ENTRIES & RICH TELEGRAM ALERTS
// ==========================================
entry1 = inTradeSession and tradesToday == 0 and not na(orbHigh) and 
         ta.crossover(close, orbHigh) and close > vwapVal and close > dailyEma and volSpike

highestRecent = ta.highest(high[1], 15)
entry2 = inTradeSession and tradesToday == 1 and 
         ta.crossover(close, highestRecent) and close > vwapVal and close > dailyEma and volSpike

validEntry = (entry1 or entry2) and strategy.position_size == 0 and tradesToday < maxTradesPerDay

var float entryPrice = 0.0
var float slLevel    = 0.0
var float tpLevel    = 0.0

if (validEntry)
    tradesToday := tradesToday + 1
    entryPrice  := close
    
    slDist   = close * 0.012
    slLevel  := close - slDist
    tpLevel  := close + (slDist * 2.1)
    tradeVal = calcQty * close
    estFee   = (math.min(20.0, tradeVal * 0.0003) * 2.0) + 1.20
    
    // Rich Alert Payload for Telegram
    alertMsg = "🦅 [PC JEWELLER 1M LIVE PREDATOR V3 - ENTRY]\n" +
               "📈 Stock: " + syminfo.ticker + "\n" +
               "🟢 Action: BUY (Intraday MIS 5x)\n" +
               "💰 Entry Price: ₹" + str.tostring(close, "#.##") + "\n" +
               "🛑 Stop Loss (1.2%): ₹" + str.tostring(slLevel, "#.##") + "\n" +
               "🎯 Target (2.1R): ₹" + str.tostring(tpLevel, "#.##") + "\n" +
               "⚡ 5x Trade Value: ₹" + str.tostring(tradeVal, "#.##") + " (" + str.tostring(calcQty) + " shares)\n" +
               "💸 Est. Dhan Charges: ₹" + str.tostring(estFee, "#.##") + "\n" +
               "⏰ Time: " + str.format_time(time, "HH:mm:ss", "Asia/Kolkata")
               
    alert(alertMsg, alert.freq_once_per_bar_close)
    
    strategy.entry("Long_Sniper", strategy.long, qty=calcQty, comment="SNIPER #" + str.tostring(tradesToday))
    strategy.exit("Exit_Sniper", "Long_Sniper", limit=tpLevel, stop=slLevel, 
                  trail_points=close * 0.012 / syminfo.mintick, 
                  trail_offset=close * 0.006 / syminfo.mintick, 
                  comment="TP/TRAIL EXIT")

// 15:15 PM EOD Mandatory Square-Off
if (isEOD and strategy.position_size != 0)
    exitFee = (math.min(20.0, strategy.position_size * close * 0.0003) * 2.0) + 1.20
    grossPnl = (close - entryPrice) * strategy.position_size
    netPnl = grossPnl - exitFee
    alert("🛑 [PREDATOR V3 - 15:15 EOD SQUARE OFF]\nStock: " + syminfo.ticker + "\nExit: ₹" + str.tostring(close, "#.##") + "\nNet PnL: ₹" + str.tostring(netPnl, "#.##"), alert.freq_once_per_bar_close)
    strategy.close_all(comment="15:15 EOD Exit")
