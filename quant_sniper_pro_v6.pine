//@version=6
strategy("QUANT SNIPER PRO [v6]", 
         shorttitle="QUANT SNIPER [v6]", 
         overlay=true, 
         initial_capital=100000, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=100, 
         commission_type=strategy.commission.percent, 
         commission_value=0.03, 
         slippage=1, 
         precision=2, 
         max_labels_count=500, 
         max_lines_count=500)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
grp_mode   = "1. Trading Mode"
trade_mode = input.string("Both (Long & Short - Intraday)", "Execution Mode", 
                          options=["Both (Long & Short - Intraday)", "Long Only (Delivery / Cash)"], 
                          group=grp_mode,
                          tooltip="Both: Takes Long on green line, Short on red line (Best for Intraday/F&O).\nLong Only: Takes Long on green line, exits to Cash on red line (Best for Delivery).")

use_ema200 = input.bool(true, "Macro 200 EMA Filter (Blocks Falling Knives)", group=grp_mode,
                        tooltip="In Long-Only mode, completely disables Buy signals if price is below 200 EMA (saves from crashes like Suzlon).")

grp_ut     = "2. Sensitivity Engine (Trade Frequency)"
a          = input.float(2.0, "Key Value Sensitivity (2.0 = Active Trades, 4.0 = Relaxed)", minval=0.5, step=0.1, group=grp_ut)
c          = input.int(7, "ATR Period", minval=1, group=grp_ut)

grp_tp     = "3. Predictive Milestone Targets"
atr_len    = input.int(14, "Volatility ATR Length", minval=5, group=grp_tp)
tp1_mult   = input.float(1.5, "TP1 Multiplier (Safe Target)", step=0.5, group=grp_tp)
tp2_mult   = input.float(3.0, "TP2 Multiplier (Expansion)", step=0.5, group=grp_tp)
tp3_mult   = input.float(5.0, "TP3 Multiplier (Moonshot)", step=0.5, group=grp_tp)

grp_re     = "4. Dynamic Re-Entry Signals"
enable_re  = input.bool(true, "Show Re-Entry Dip Signals", group=grp_re,
                        tooltip="Shows ⚡ RE-BUY signals when price dips into EMA 9 during an ongoing trend.")
rsi_len    = input.int(7, "Re-Entry RSI Length", minval=3, group=grp_re)

// ==============================================================================
// 2. QUANT CALCULATIONS
// ==============================================================================
// Macro 200 EMA & 9 EMA
ema200 = ta.ema(close, 200)
ema9   = ta.ema(close, 9)
plot(ema200, title="Macro 200 EMA", color=color.new(color.orange, 25), linewidth=2)

// Volatility ATR
vol_atr = ta.atr(atr_len)

// UT Bot ATR Trailing Stop Line
xATR  = ta.atr(c)
nLoss = a * xATR

var float xATRTrailingStop = 0.0
prevStop = nz(xATRTrailingStop[1], 0.0)

if close > prevStop and close[1] > prevStop
    xATRTrailingStop := math.max(prevStop, close - nLoss)
else if close < prevStop and close[1] < prevStop
    xATRTrailingStop := math.min(prevStop, close + nLoss)
else if close > prevStop
    xATRTrailingStop := close - nLoss
else
    xATRTrailingStop := close + nLoss

color trail_color = close > xATRTrailingStop ? color.green : color.red
plot(xATRTrailingStop, title="Live Dynamic Trailing Line", color=trail_color, linewidth=2, style=plot.style_linebr)

// Fast RSI for Re-entry
fast_rsi = ta.rsi(close, rsi_len)

// ==============================================================================
// 3. EXECUTION STATE MACHINE
// ==============================================================================
var int pos = 0 // 1 = Long, -1 = Short, 0 = Flat
var float entry_p = na
var float tp1_dyn = na
var float tp2_dyn = na
var float tp3_dyn = na
var bool tp1_crossed = false
var bool tp2_crossed = false

bool is_both = (trade_mode == "Both (Long & Short - Intraday)")
bool macro_bullish = close > ema200
bool allow_long = not use_ema200 or macro_bullish

time_ok = (hour > 9 or (hour == 9 and minute >= 20))

buy_cross  = ta.crossover(close, xATRTrailingStop)
sell_cross = ta.crossunder(close, xATRTrailingStop)

// Entry Conditions
buy_condition  = (pos <= 0) and buy_cross and allow_long and time_ok
sell_condition = is_both ? ((pos >= 0) and sell_cross and time_ok) : ((pos == 1) and sell_cross)

// Re-Entry Dip Signal (When already Long and price pulls back to EMA 9 with RSI dip)
reentry_buy = enable_re and (pos == 1) and (fast_rsi < 42 or fast_rsi[1] < 42) and ta.crossover(close, ema9) and (close > open) and not buy_cross
reentry_short = enable_re and is_both and (pos == -1) and (fast_rsi > 58 or fast_rsi[1] > 58) and ta.crossunder(close, ema9) and (close < open) and not sell_cross

// --- STRATEGY ORDERS ---
if buy_condition
    pos := 1
    entry_p := close
    tp1_dyn := close + (vol_atr * tp1_mult)
    tp2_dyn := close + (vol_atr * tp2_mult)
    tp3_dyn := close + (vol_atr * tp3_mult)
    tp1_crossed := false
    tp2_crossed := false
    strategy.entry("Long", strategy.long)

if sell_condition
    if is_both
        pos := -1
        entry_p := close
        tp1_dyn := close - (vol_atr * tp1_mult)
        tp2_dyn := close - (vol_atr * tp2_mult)
        tp3_dyn := close - (vol_atr * tp3_mult)
        tp1_crossed := false
        tp2_crossed := false
        strategy.entry("Short", strategy.short)
    else
        pos := 0
        entry_p := na
        tp1_dyn := na
        tp2_dyn := na
        tp3_dyn := na
        strategy.close("Long", comment="Exit to Cash")

// Informational Milestone Labels
if pos == 1
    if high >= tp1_dyn and not tp1_crossed
        tp1_crossed := true
        label.new(bar_index, high, text="🎯 TP1 ₹" + str.tostring(high, "#.##") + "\n(Safe Profit)", color=color.teal, textcolor=color.white, style=label.style_label_down, size=size.small)
    if high >= tp2_dyn and not tp2_crossed
        tp2_crossed := true
        label.new(bar_index, high, text="🚀 TP2 ₹" + str.tostring(high, "#.##") + "\n(Big Profit)", color=color.blue, textcolor=color.white, style=label.style_label_down, size=size.small)

if pos == -1 and is_both
    if low <= tp1_dyn and not tp1_crossed
        tp1_crossed := true
        label.new(bar_index, low, text="🎯 TP1 Short ₹" + str.tostring(low, "#.##"), color=color.teal, textcolor=color.white, style=label.style_label_up, size=size.small)
    if low <= tp2_dyn and not tp2_crossed
        tp2_crossed := true
        label.new(bar_index, low, text="🚀 TP2 Short ₹" + str.tostring(low, "#.##"), color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.small)

// ==============================================================================
// 4. CHART LABELS & SIGNALS
// ==============================================================================
plotshape(buy_condition, title="Buy Signal", text="🟢 BUY", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.normal)
plotshape(sell_condition and is_both, title="Short Signal", text="🔴 SHORT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.normal)
plotshape(sell_condition and not is_both, title="Exit Signal", text="🔴 EXIT", style=shape.labeldown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.normal)

// Re-Entry Dip Buy Signals
plotshape(reentry_buy, title="Re-Entry Dip Buy", text="⚡ RE-BUY", style=shape.triangleup, location=location.belowbar, color=color.lime, textcolor=color.black, size=size.small)
plotshape(reentry_short, title="Re-Entry Short", text="⚡ RE-SHORT", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, textcolor=color.white, size=size.small)

// Milestone Target Lines
plot(pos != 0 ? tp1_dyn : na, title="Target 1", color=color.new(color.green, 20), style=plot.style_circles, linewidth=2)
plot(pos != 0 ? tp2_dyn : na, title="Target 2", color=color.new(color.teal, 20), style=plot.style_circles, linewidth=2)

// Zone Background & Candle Colors
color bg_col = pos == 1 ? color.new(color.green, 92) : pos == -1 ? color.new(color.red, 92) : color.new(color.gray, 95)
bgcolor(bg_col, title="Zone Background")
barcolor(close > xATRTrailingStop ? color.green : color.red)

// ==============================================================================
// 5. LIVE HUD DASHBOARD
// ==============================================================================
var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "QUANT SNIPER PRO", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "STATUS", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    string pos_txt = pos == 1 ? "LONG 🟢" : pos == -1 ? "SHORT 🔴" : "CASH / FLAT ⚪"
    color pos_c    = pos == 1 ? color.green : pos == -1 ? color.red : color.gray
    table.cell(hud, 0, 1, "Active Position", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, pos_txt, text_color=pos_c, text_size=size.small)
    
    table.cell(hud, 0, 2, "Live Trailing SL", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, "₹" + str.tostring(xATRTrailingStop, "#.##"), text_color=trail_color, text_size=size.small)
    
    string reg_txt = macro_bullish ? "BULL (ABOVE 200 EMA) 🚀" : "BEAR (BELOW 200 EMA) 🔻"
    color reg_c    = macro_bullish ? color.green : color.red
    table.cell(hud, 0, 3, "200 EMA Macro Gate", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, reg_txt, text_color=reg_c, text_size=size.small)
    
    string act_txt = pos == 1 ? (fast_rsi < 42 ? "DIP BUY READY 🟢" : "HOLDING RUNNER") : pos == -1 ? "HOLDING SHORT 🔴" : "WAIT FOR SIGNAL ⚪"
    table.cell(hud, 0, 4, "Next Action", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, act_txt, text_color=color.yellow, text_size=size.small)
