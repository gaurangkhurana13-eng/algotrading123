# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
env/

# Datasets and caches
data/
junk/
scratch/
reports/
src/
*.pkl
*.parquet
*.h5
*.feather
*.csv.gz

# Ignore all scripts except our cloud tester and multi_slot engine
scripts/*
!scripts/live_telegram_forward_tester.py
!scripts/multi_slot_sim_engine.py

# Ignore all strategies except V43 and V3
strategies/*
!strategies/V43/
!strategies/V3/
!strategies/framework.py
strategies/V3/*.csv
strategies/V3/*.txt
strategies/V3/run_v3.py
strategies/V3/v3.pine
strategies/V3/pc_jeweller_1m_predator_v3_telegram.pine

# Ignore all legacy testing folders
trading_system/
real_versions/
lightgbm/
V20/
V21/
catboost/

# Exclude loose root scratch & test files
/*.py
!/framework.py
/*.ipynb
/*.md
!/README.md
/*.txt
!/requirements.txt
/*.html
/*.js
/*.json
/*.bat
/*.pine
*.csv

# Local secrets & configs
config/telegram_config.json
!config/telegram_config.example.json
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
